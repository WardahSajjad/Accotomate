# Contact form email delivery (src/app/api/contact/route.ts)
#
# Without these, the form still validates and submits, but the API returns
# 503 "not_configured" and the form offers the visitor a mailto fallback
# instead of silently discarding the enquiry.
#
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify accotomate.com as a sending domain
# 3. Copy this file to .env.local and fill both values

RESEND_API_KEY=
CONTACT_FROM_EMAIL="Accotomate <website@accotomate.com>"
